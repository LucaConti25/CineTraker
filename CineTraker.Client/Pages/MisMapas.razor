@page "/mis-mapas"
@using CineTraker.Shared
@using CineTraker.Shared.Models
@inject HttpClient Http
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="main-content-container pb-5">
    <div class="container pt-5 text-white" style="padding-bottom: 100px;">
        <h2 class="mb-4 text-warning"><i class="bi bi-map"></i> Mis Expediciones</h2>

        @if (mapas == null)
        {
                <div class="text-center mt-5">
                    <div class="spinner-border text-warning" role="status" style="width: 3rem; height: 3rem;"></div>
                    <p class="mt-2">Cargando tus mapas...</p>
                </div>
        }
        else if (!mapas.Any())
        {
                <div class="text-center mt-5 p-5 bg-dark rounded border border-secondary">
                    <i class="bi bi-compass text-secondary" style="font-size: 4rem;"></i>
                    <h4 class="mt-3">El lienzo está en blanco</h4>
                    <p class="text-muted">Aún no has comenzado ningún mapa. ¡Toca el botón + para iniciar tu primera expedición!</p>
                </div>
        }
        else
        {
                <div class="row">
                @foreach (var mapa in mapas)
                {
                            <div class="col-md-4 mb-4">
                        @* TARJETA REDISEÑADA CON POSTER DE FONDO *@
                                <div class="card h-100 border-0 shadow-lg mapa-card" 
                                     style="background-image: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.4) 100%), url('@(mapa.SeedMovie?.PosterUrl ?? "")');">

                                    <div class="card-body d-flex flex-column justify-content-end text-white">
                                        <h4 class="card-title text-warning fw-bold mb-1">@mapa.Name</h4>
                                        <p class="card-text small text-light mb-3">
                                            <i class="bi bi-clock-history"></i> Actualizado: @mapa.CreatedDate.ToString("dd MMM yyyy")
                                        </p>

                                        <div class="mt-auto">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <span class="text-light small"><i class="bi bi-diagram-3"></i> Nodos explorados:</span>
                                                <span class="badge bg-warning text-dark fs-6 shadow-sm">@mapa.TotalMovies</span>
                                            </div>

                                            <button class="btn btn-warning w-100 fw-bold shadow-sm" @onclick="() => Continuar(mapa.Id)">
                                                <i class="bi bi-play-fill"></i> Continuar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                }
                </div>
        }

        @* BOTÓN FLOTANTE (FAB) *@
        <button class="fab-button shadow-lg" @onclick="AbrirModal" title="Nueva Expedición">
            <i class="bi bi-plus-lg"></i>
        </button>

        @* MODAL PARA ELEGIR PELÍCULA SEMILLA *@
        @if (mostrarModal)
        {
                <div class="modal-overlay" @onclick="CerrarModal">
                    <div class="modal-content bg-dark text-white p-4 rounded shadow border border-secondary" @onclick:stopPropagation="true">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="m-0 text-warning">Nueva Expedición</h4>
                            <button class="btn btn-sm btn-outline-light border-0" @onclick="CerrarModal"><i class="bi bi-x-lg"></i></button>
                        </div>

                        <p class="text-muted small mb-3">Selecciona una película que ya hayas reseñado para que sea el núcleo de tu nuevo mapa.</p>

                    @if (cargandoResenas)
                    {
                                <div class="text-center py-4"><div class="spinner-border text-info"></div></div>
                    }
                    else if (misResenasFiltradas == null || !misResenasFiltradas.Any())
                    {
                                <div class="alert alert-warning text-dark text-center">
                                    <i class="bi bi-exclamation-triangle"></i> No tienes películas reseñadas aún. Ve al catálogo, guarda una reseña y vuelve aquí.
                                </div>
                    }
                    else
                    {
                                <div class="list-group list-group-flush" style="max-height: 300px; overflow-y: auto;">
                            @foreach (var review in misResenasFiltradas)
                            {
                                            <button class="list-group-item list-group-item-action bg-secondary text-white border-dark d-flex align-items-center" 
                                                    @onclick="() => CrearNuevoMapa(review.MovieId)" disabled="@creandoMapa">

                                                <img src="@review.Movie?.PosterUrl" alt="Poster" class="rounded me-3" style="width: 40px; height: 60px; object-fit: cover;" />

                                                <div class="flex-grow-1 text-start">
                                                    <div class="fw-bold">@review.Movie?.Title</div>
                                                    <div class="text-warning small">
                                            @for (int i = 0; i < review.Stars; i++)
                                            {
                                                                <i class="bi bi-star-fill"></i>
                                            }
                                                    </div>
                                                </div>

                                                <i class="bi bi-chevron-right text-muted"></i>
                                            </button>
                            }
                                </div>
                    }
                    </div>
                </div>
        }
    </div>
</div>

@code {
    private List<UserMap>? mapas;

    // Variables para el modal
    private bool mostrarModal = false;
    private bool cargandoResenas = false;
    private bool creandoMapa = false;
    private List<Review>? misResenasFiltradas; // Asumiendo que tenés un modelo Review

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity == null || !user.Identity.IsAuthenticated)
        {
            Nav.NavigateTo("login?returnUrl=mis-mapas");
            return;
        }

        await CargarMapas();
    }

    private async Task CargarMapas()
    {
        try
        {
            mapas = await Http.GetFromJsonAsync<List<UserMap>>("/api/maps/my-maps");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar mapas: {ex.Message}");
            mapas = new List<UserMap>();
        }
    }

    // --- LÓGICA DE NAVEGACIÓN ---
    private void Continuar(int mapaId)
    {
        // AHORA VIAJAMOS AL MAPA POR SU ID PROPIO, NO POR LA PELÍCULA
        Nav.NavigateTo($"/mapa/{mapaId}");
    }

    // --- LÓGICA DEL MODAL ---
    private async Task AbrirModal()
    {
        mostrarModal = true;
        cargandoResenas = true;
        StateHasChanged();

        try
        {
            // Consumimos el endpoint de reviews que armamos la sesión pasada
            var todasMisResenas = await Http.GetFromJsonAsync<List<Review>>("/api/reviews/user");

            // Agrupamos por película y nos quedamos con la reseña más reciente de cada una
            if (todasMisResenas != null)
            {
                misResenasFiltradas = todasMisResenas
                    .GroupBy(r => r.MovieId)
                    .Select(g => g.OrderByDescending(r => r.Id).First()) // Asumiendo que mayor ID = más reciente
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar reseñas: {ex.Message}");
            misResenasFiltradas = new List<Review>();
        }

        cargandoResenas = false;
        StateHasChanged();
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task CrearNuevoMapa(int movieId)
    {
        if (creandoMapa) return;
        creandoMapa = true;
        StateHasChanged();

        try
        {
            // Llamamos al nuevo endpoint de creación
            var response = await Http.PostAsync($"/api/maps/create/{movieId}", null);

            if (response.IsSuccessStatusCode)
            {
                var mapaNuevo = await response.Content.ReadFromJsonAsync<UserMap>();
                if (mapaNuevo != null && mapaNuevo.Id > 0)
                {
                    // Si se creó con éxito, viajamos directo a la ruta del nuevo mapa
                    Nav.NavigateTo($"/mapa/{mapaNuevo.Id}");
                }
            }
            else
            {
                Console.WriteLine("Error al crear el mapa.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Excepción al crear mapa: {ex.Message}");
        }

        creandoMapa = false;
        StateHasChanged();
    }
}

<style>
    
     .main-content-container {
        background-color: #121212 !important;
        min-height: 100vh;
    }

    /* Estilos de la Tarjeta */
    .mapa-card {
        background-size: cover;
        background-position: center;
        border-radius: 15px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        min-height: 250px;
    }
    .mapa-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(255, 193, 7, 0.2) !important;
    }

    /* Botón Flotante */
    .fab-button {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 60px;
        height: 60px;
        background-color: #ffc107;
        color: #000;
        border-radius: 50%;
        border: none;
        font-size: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 1000;
        transition: background-color 0.3s ease, transform 0.3s ease;
    }
    .fab-button:hover {
        background-color: #ffca2c;
        transform: scale(1.1);
    }

    /* Modal Oscuro */
    .modal-overlay {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.8); backdrop-filter: blur(5px);
        display: flex; align-items: center; justify-content: center; z-index: 2000;
    }
    .modal-content { 
        width: 90%; max-width: 500px; border-radius: 15px;
    }

    /* Scrollbar del listado */
    .list-group::-webkit-scrollbar { width: 8px; }
    .list-group::-webkit-scrollbar-track { background: #343a40; border-radius: 4px; }
    .list-group::-webkit-scrollbar-thumb { background: #6c757d; border-radius: 4px; }
</style>