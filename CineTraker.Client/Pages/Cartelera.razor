@page "/explorar"
@using CineTraker.Shared
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
<PageTitle>CineTraker - Explorar</PageTitle>

<div class="container-fluid px-3 px-md-5 pt-4">

    <div class="mb-4">
        <h2 class="fw-bold m-0 text-light section-title">Catálogo Mundial</h2>
        <p class="text-muted small mb-0 mt-2 ms-3">Descubre, califica y expande tu universo cinemático.</p>
    </div>

    <div class="mb-4">
        <SearchBar SearchText="@textoBusqueda"
                   OnSearch="EjecutarBusquedaLocal"
                   ShowFallback="@(peliculas != null && peliculas.Count == 0 && !string.IsNullOrEmpty(textoBusqueda) && !cargandoMas && !buscandoLocal)"
                   IsSearchingOmdb="buscandoEnApi"
                   OnOmdbSearch="EjecutarBusquedaInteligente" />
    </div>

    <FilterPanel FiltrosDecadas="filtrosDecadas"
                 Generos="generos"
                 Plataformas="plataformasFrecuentes"
                 GeneroSeleccionado="@generoSeleccionado"
                 RatingSeleccionado="@ratingSeleccionado"
                 PlataformaSeleccionada="@plataformaSeleccionada"
                 OnDecadaChanged="SeleccionarDecada"
                 OnGeneroChanged="SeleccionarGenero"
                 OnRatingChanged="SeleccionarRating"
                 OnPlataformaChanged="SeleccionarPlataforma" />

    <hr class="border-secondary mb-4" />

    @if (peliculas.Count == 0 && !finDelCatalogo)
    {
        <div class="text-center mt-5 py-5">
            <div class="spinner-border text-warning" role="status"></div>
            <p class="text-muted mt-2">@(buscandoLocal ? "Buscando..." : "Cargando catálogo...")</p>
        </div>
    }
    else if (peliculas.Count == 0 && finDelCatalogo && buscandoLocal)
    {
        <div class="text-center mt-5 py-5">
            <div class="spinner-border text-warning" role="status"></div>
            <p class="text-muted mt-2">Buscando...</p>
        </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 row-cols-xl-6 g-3 g-md-4 mb-5">
            @foreach (var peli in PeliculasFiltradas)
            {
                <div class="col">
                    <MovieCard Movie="peli" OnClick="IrAPelicula" />
                </div>
            }
        </div>

        @if (cargandoMas)
        {
            <div class="text-center my-4 w-100">
                <div class="spinner-border text-warning" role="status"></div>
                <p class="text-muted">Buscando más joyas...</p>
            </div>
        }
    }
</div>

<OmdbModal Show="mostrarModalExterno"
           IsSearching="buscandoEnApi"
           Resultados="resultadosExternos"
           OnClose="CerrarModalExterno"
           OnConfirm="ConfirmarYGuardar" />

@if (mostrarFeedback)
{
    <div class="feedback-toast shadow-lg border-0 animacion-entrada">
        <div class="d-flex align-items-center p-3 text-white bg-success rounded">
            <i class="bi bi-check-circle-fill me-2 fs-4"></i>
            <div>
                <strong class="d-block">¡Agregada con éxito!</strong>
                <span class="small">"@peliculaAgregada" ya está en tu catálogo.</span>
            </div>
        </div>
    </div>
}

<style>
    body {
        background-color: #0f0f0f;
        color: white;
        margin: 0;
        padding: 0;
    }
    
    .section-title {
        border-left: 4px solid #ffc107;
        padding-left: 12px;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 1.5rem;
    }

    .feedback-toast {
        position: fixed;
        bottom: 30px;
        right: 30px;
        z-index: 10000;
        min-width: 250px;
    }

    .animacion-entrada {
        animation: slideInRight 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @@keyframes slideInRight {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }
    
    @@media (max-width: 767.98px) {
        main { padding-top: 0 !important; }
        .top-row { height: 50px !important; min-height: 50px !important; display: flex; align-items: center; }
    }
</style>

@code {
    private List<Movie> peliculas = new List<Movie>();
    private string textoBusqueda = "";
    private bool buscandoEnApi = false;
    private List<FiltroDecada> filtrosDecadas = new();
    
    private bool esAdmin = false;
    private int skipActual = 0;        
    private const int takeTanda = 20;   
    private bool cargandoMas = false;   
    private bool finDelCatalogo = false;
    private bool buscandoLocal = false; 

    private List<Movie> resultadosExternos = new(); 
    private bool mostrarModalExterno = false;       
    private bool mostrarFeedback = false;
    private string peliculaAgregada = "";
    
    private string? generoSeleccionado = null;
    private string? plataformaSeleccionada = null;
    private double? ratingSeleccionado = null;
    private List<string> generos = new() { "Action", "Drama", "Comedy", "Thriller", "Horror", "Sci-Fi" };
    private List<string> plataformasFrecuentes = new() { "Netflix", "MAX", "Disney+", "Prime Video", "AppleTV", "MUBI", "Clarovideo", "Paramount Plus" };

    private List<Movie> PeliculasFiltradas
    {
        get
        {
            var query = peliculas ?? new List<Movie>();
            var seleccionado = filtrosDecadas.FirstOrDefault(f => f.Seleccionado);
            if (seleccionado != null)
                query = query.Where(p => p.Year >= seleccionado.AnioInicio && p.Year <= seleccionado.AnioInicio + 9).ToList();

            if (!string.IsNullOrEmpty(plataformaSeleccionada))
            {
                query = query.Where(p => p.Sources != null && p.Sources.Any(s => s.Name.Contains(plataformaSeleccionada))).ToList();
            }
            return query.OrderByDescending(p =>
            {
                double.TryParse(p.ImdbRating, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var r);
                return r;
            }).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        esAdmin = authState.User.IsInRole("Admin");

        for (int anio = 1930; anio <= 2020; anio += 10)
        {
            filtrosDecadas.Add(new FiltroDecada(anio));
        }

        var dotNetHelper = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("inicializarScrollInfinito", dotNetHelper);
        await CargarCatalogo(true);
    }

    private async Task EjecutarBusquedaLocal(string busqueda)
    {
        textoBusqueda = busqueda;
        await CargarCatalogo(true);
    }

    private void IrAPelicula(Movie pelicula)
    {
        Nav.NavigateTo($"/pelicula/{pelicula.Id}");
    }

    [JSInvokable]
    public async Task CargarSiguientePagina()
    {
        if (cargandoMas || finDelCatalogo) return;
        cargandoMas = true;
        skipActual += takeTanda;

        var url = $"api/Movies?skip={skipActual}&take={takeTanda}";
        if (!string.IsNullOrEmpty(generoSeleccionado)) url += $"&genre={generoSeleccionado}";
        if (ratingSeleccionado.HasValue) url += $"&minRating={ratingSeleccionado.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
        if (!string.IsNullOrEmpty(plataformaSeleccionada)) url += $"&platform={Uri.EscapeDataString(plataformaSeleccionada)}";

        var nuevasPelis = await Http.GetFromJsonAsync<List<Movie>>(url);
        if (nuevasPelis != null && nuevasPelis.Any())
        {
            peliculas?.AddRange(nuevasPelis);
        }
        else
        {
            finDelCatalogo = true;
        }

        cargandoMas = false;
        StateHasChanged();
    }

    private async Task SeleccionarDecada(FiltroDecada filtro)
    {
        var yaEstabaSeleccionado = filtro.Seleccionado;
        filtrosDecadas.ForEach(f => f.Seleccionado = false);
        if (!yaEstabaSeleccionado) filtro.Seleccionado = true;
        StateHasChanged();
    }

    private async Task SeleccionarGenero(string? g)
    {
        generoSeleccionado = g;
        await CargarCatalogo(true);
    }

    private async Task SeleccionarRating(double? r)
    {
        ratingSeleccionado = r;
        await CargarCatalogo(true);
    }

    private async Task SeleccionarPlataforma(string? p)
    {
        plataformaSeleccionada = p;
        await CargarCatalogo(true);
    }

    private async Task CargarCatalogo(bool esNuevaBusqueda = false)
    {
        buscandoLocal = true;
        StateHasChanged();

        if (esNuevaBusqueda)
        {
            skipActual = 0;
            finDelCatalogo = false;
            peliculas = new List<Movie>();
        }

        try
        {
            var queryParams = new List<string>();
            queryParams.Add($"skip={skipActual}");
            queryParams.Add($"take={takeTanda}");

            if (!string.IsNullOrWhiteSpace(textoBusqueda))
                queryParams.Add($"search={Uri.EscapeDataString(textoBusqueda)}");

            if (!string.IsNullOrEmpty(generoSeleccionado))
                queryParams.Add($"genre={generoSeleccionado}");

            if (ratingSeleccionado.HasValue && ratingSeleccionado > 0)
                queryParams.Add($"minRating={ratingSeleccionado.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}");

            if (!string.IsNullOrEmpty(plataformaSeleccionada))
            {
                var plataformaCodificada = Uri.EscapeDataString(plataformaSeleccionada);
                queryParams.Add($"platform={plataformaCodificada}");
            }

            var url = "api/Movies?" + string.Join("&", queryParams);
            var resultado = await Http.GetFromJsonAsync<List<Movie>>(url);

            if (resultado != null)
            {
                if (esNuevaBusqueda || peliculas == null) peliculas = resultado;
                else peliculas.AddRange(resultado);

                if (resultado.Count < takeTanda) finDelCatalogo = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error cargando películas: " + ex.Message);
        }
        finally
        {
            buscandoLocal = false;
            StateHasChanged();
        }
    }

    private async Task EjecutarBusquedaInteligente()
    {
        buscandoEnApi = true;
        mostrarModalExterno = true;
        StateHasChanged(); 
        
        var urlSmart = $"api/Movies/smart-search/{Uri.EscapeDataString(textoBusqueda)}";
        var res = await Http.GetFromJsonAsync<List<Movie>>(urlSmart);
        if (res != null) resultadosExternos = res;
        
        buscandoEnApi = false;
        StateHasChanged();
    }

    private void CerrarModalExterno()
    {
        mostrarModalExterno = false;
        StateHasChanged();
    }

    private async Task ConfirmarYGuardar(Movie elegida)
    {
        mostrarModalExterno = false;
        
        var respuesta = await Http.PostAsJsonAsync("api/Movies/save-by-id", elegida.ImdbID);
        if (respuesta.IsSuccessStatusCode)
        {
            var peliGuardada = await respuesta.Content.ReadFromJsonAsync<Movie>();
            if (peliGuardada != null)
            {
                textoBusqueda = "";
                await CargarCatalogo(true);

                peliculaAgregada = peliGuardada.Title;
                mostrarFeedback = true;
                StateHasChanged();

                await Task.Delay(3000);
                mostrarFeedback = false;
                StateHasChanged();
            }
        }
    }
}