@page "/login"
@using CineTraker.Shared
@using CineTraker.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthService AuthService
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider

<div class="login-background d-flex align-items-center justify-content-center">
    <div class="col-11 col-sm-8 col-md-6 col-lg-4">
        @* Tarjeta con efecto glassmorphism (transparente y borrosa) *@
        <div class="card shadow-lg text-white border-0 rounded-4" style="background-color: rgba(33, 37, 41, 0.85); backdrop-filter: blur(10px);">
            <div class="card-body p-5">

                @* Branding *@
                <div class="text-center mb-4">
                    <h2 class="text-warning fw-bold mb-1"><i class="bi bi-film"></i> CineTraker</h2>
                    <p class="text-muted small">Tu diario y mapa cinematográfico</p>
                </div>

                <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />

                    @* Input de Email con Icono *@
                    <div class="mb-3">
                        <label class="form-label text-light small">Email</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-secondary border-0 text-warning"><i class="bi bi-envelope-fill"></i></span>
                            <InputText @bind-Value="loginModel.Email" class="form-control bg-secondary text-white border-0 shadow-none" placeholder="ejemplo@correo.com" />
                        </div>
                        <ValidationMessage For="@(() => loginModel.Email)" class="text-danger small mt-1" />
                    </div>

                    @* Input de Password con Icono *@
                    <div class="mb-4">
                        <label class="form-label text-light small">Contraseña</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-secondary border-0 text-warning"><i class="bi bi-lock-fill"></i></span>
                            <InputText @bind-Value="loginModel.Password" type="password" class="form-control bg-secondary text-white border-0 shadow-none" placeholder="********" />
                        </div>
                        <ValidationMessage For="@(() => loginModel.Password)" class="text-danger small mt-1" />
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                            <div class="alert alert-danger py-2 small border-0 shadow-sm"><i class="bi bi-exclamation-triangle-fill"></i> @errorMessage</div>
                    }

                    <button type="submit" class="btn btn-warning w-100 fw-bold shadow-sm rounded-3 py-2 mt-2" disabled="@estaCargando">
                        @if (estaCargando)
                        {
                                <span class="spinner-border spinner-border-sm text-dark"></span>
                                <span class="ms-2 text-dark">Preparando la sala...</span>
                        }
                        else
                        {
                                <span><i class="bi bi-box-arrow-in-right"></i> Entrar a la función</span>
                        }
                    </button>

                    <div class="mt-4 text-center">
                        <span class="text-muted small">¿No tenés cuenta?</span>
                        <NavLink href="/register" class="btn btn-link btn-sm text-warning fw-bold text-decoration-none">Registrate acá</NavLink>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@if (mostrarFeedback)
{
        <div class="feedback-toast shadow-lg border-0 animacion-entrada">
            <div class="d-flex align-items-center p-3 text-dark bg-warning rounded-3 shadow">
                <i class="bi bi-check-circle-fill me-2 fs-4"></i>
                <div>
                    <strong class="d-block fw-bold">¡Bienvenido!</strong>
                    <span class="small">Inicio de sesión exitoso.</span>
                </div>
            </div>
        </div>
}

<style>
    /* Fondo inmersivo que ocupa toda la pantalla sin scroll */
    .login-background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        /* Usamos una imagen de Unsplash de cine oscurecida */
        background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(15, 15, 15, 0.95)), url('https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=1920') no-repeat center center;
        background-size: cover;
        overflow: hidden;
        z-index: 1050; /* Lo ponemos por encima de la navbar (MainLayout) si es que existe en esta vista */
    }

    /* Ajuste para que el input no se ponga blanco feo al hacer clic */
    .form-control:focus {
        background-color: #495057;
        color: white;
    }

    .feedback-toast {
        position: fixed;
        bottom: 30px;
        right: 30px;
        z-index: 11000;
        min-width: 250px;
    }

    .animacion-entrada {
        animation: slideInRight 0.5s ease-out;
    }

    @@keyframes slideInRight {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }
</style>

@code {
    private Login loginModel = new Login();
    private string? errorMessage;
    private bool estaCargando = false;
    private bool mostrarFeedback = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated ?? false)
        {
            NavManager.NavigateTo("/");
        }
    }

    private async Task HandleLogin()
    {
        estaCargando = true;
        errorMessage = null;

        try
        {
            var success = await AuthService.Login(loginModel);
            if (success)
            {
                mostrarFeedback = true;
                StateHasChanged();

                await Task.Delay(1500);
                NavManager.NavigateTo("/");
            }
            else
            {
                errorMessage = "Email o contraseña incorrectos.";
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "No se pudo conectar con el servidor. Reintente más tarde.";
        }
        catch (Exception)
        {
            errorMessage = "Ocurrió un error inesperado.";
        }
        finally
        {
            estaCargando = false;
        }
    }
}