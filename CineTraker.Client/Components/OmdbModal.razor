@using CineTraker.Shared

@if (Show)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-content">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-warning m-0">¿Cuál de estas buscabas?</h5>
                <button class="btn-close btn-close-white" @onclick="Cerrar"></button>
            </div>

            <div class="modal-results-body">
            @if (IsSearching)
            {
                <div class="text-center py-4">
                    <div class="spinner-border text-warning"></div>
                    <p class="text-muted mt-2">Consultando a internet...</p>
                </div>
            }
            else
            {
                <div class="row row-cols-2 row-cols-md-3 g-3">
                    @foreach (var res in Resultados)
                    {
                        <div class="col">
                            <div class="card h-100 bg-dark border-secondary option-card" @onclick="() => Confirmar(res)">
                                <img src="@res.SafePosterUrl" class="card-img-top">
                                <div class="card-body p-2">
                                    <p class="small fw-bold mb-0 text-truncate text-light">@res.Title</p>
                                    <span class="text-muted small">@res.Year</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public bool IsSearching { get; set; }
    [Parameter] public List<Movie> Resultados { get; set; } = new();
    
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<Movie> OnConfirm { get; set; }

    private async Task Cerrar()
    {
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }

    private async Task Confirmar(Movie movie)
    {
        if (OnConfirm.HasDelegate) await OnConfirm.InvokeAsync(movie);
    }
}
